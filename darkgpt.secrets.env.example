# Copy this file to  darkgpt.secrets.env  and fill in your REAL values.
# darkgpt.secrets.env is git-ignored, so it can never be committed by accident.
# Keep this file only on your VPS — never paste secrets into GitHub.

GITHUB_TOKEN=ghp_your_new_github_token
BOT_TOKEN=your_new_telegram_bot_token
OPENROUTER_API_KEY=sk-or-your_new_openrouter_key
SUPABASE_SERVICE_KEY=sb_secret_your_new_supabase_key
ADMIN_IDS=your_telegram_user_id
